// fastfetch · coolnight — shown once a day by ~/.zshrc (run `ff` anytime)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "macOS_small",
    "color": { "1": "green", "2": "cyan", "3": "blue", "4": "magenta", "5": "red", "6": "yellow" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "green" },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[34m────────────────────────────\u001b[0m" },
    { "type": "os",       "key": " os" },
    { "type": "host",     "key": " host" },
    { "type": "uptime",   "key": " up" },
    { "type": "packages", "key": " pkgs" },
    { "type": "shell",    "key": " shell" },
    { "type": "terminal", "key": " term" },
    { "type": "cpu",      "key": " cpu" },
    { "type": "memory",   "key": " mem" },
    { "type": "disk",     "key": " disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}

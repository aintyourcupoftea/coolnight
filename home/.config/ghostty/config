# ╚══════════════════════════════════════════════════════════════════════╝

# ─── Font ──────────────────────────────────────────────────────────────
# needs: brew install --cask font-fira-code-nerd-font
# (without it Ghostty silently falls back to its built-in JetBrains Mono)
font-family = FiraCode Nerd Font Mono
font-style = Regular
font-size = 19
font-thicken = true
font-feature = calt
font-feature = liga
font-feature = ss01
# extra FiraCode flavor, uncomment to taste (ss03 = cleaner &, ss05 = simpler @).
# Keep comments on their own line: Ghostty reads "# ..." after a value as part of it.
# font-feature = ss03
# font-feature = ss05
adjust-cell-height = 12%

# ─── Rendering ─────────────────────────────────────────────────────────
# gamma-correct blending — crisper glyphs on a translucent background
alpha-blending = linear-corrected
# wide-gamut output so the neon cyan/green actually glow on this display
window-colorspace = display-p3
# never let text melt into the background photo
minimum-contrast = 1.1
# bold text uses the bright palette row
bold-color = bright

# ─── Background image ──────────────────────────────────────────────────
background-image = ~/.config/ghostty/background.jpeg
background-image-position = center
background-image-fit = cover
background-image-repeat = false
background-image-opacity = 0.45

# ─── Window ────────────────────────────────────────────────────────────
background-opacity = 0.8
background-blur = 20
macos-titlebar-style = hidden
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
macos-option-as-alt = true
# reopen windows/tabs where you left them after quit
window-save-state = always
# OmniWM re-tiles constantly; don't flash a "120×40" size badge every time
resize-overlay = never

# ─── Dock icon (coolnight edition) ─────────────────────────────────────
# custom-styled Ghostty icon: neon ghost on a navy→cyan screen
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #47FF9C
macos-icon-screen-color = #011423,#0FC5ED

# ─── coolnight colorscheme ─────────────────────────────────────────────
background = #011423
foreground = #CBE0F0

cursor-color = #47FF9C
cursor-text = #011423
cursor-style = block
cursor-style-blink = false

selection-background = #033259
selection-foreground = #CBE0F0

# native search (cmd+f) highlights, matched to the theme
search-background = #FFE073
search-foreground = #011423
search-selected-background = #47FF9C
search-selected-foreground = #011423

# normal
palette = 0=#214969
palette = 1=#E52E2E
palette = 2=#44FFB1
palette = 3=#FFE073
palette = 4=#0FC5ED
palette = 5=#A277FF
palette = 6=#24EAF7
palette = 7=#CBE0F0

# bright
palette = 8=#3B6E8F
palette = 9=#FF5C5C
palette = 10=#6BFFC4
palette = 11=#FFEBA1
palette = 12=#5BD8F5
palette = 13=#BE9EFF
palette = 14=#63F1FA
palette = 15=#E8F4FF

# derive colors 16–255 from the 16 above, so apps using the 256-color
# palette (prompts, vim themes, tput) come out in coolnight tones instead
# of stock xterm. Dark→light order is kept, so legacy apps stay readable.
palette-generate = true

# ─── Cursor effects ────────────────────────────────────────────────────
# coolnight comet: the cursor smears neon green → cyan when it jumps 2+ cells
# (word jumps, new lines, history, vim motions; plain typing stays calm),
# plus a quick ripple when a window/split gains focus. Pixels outside the
# effect pass through untouched, so the background is never altered.
# Tune it at the top of the file. To turn it off, comment this line out and reload.
# Shaders keep a render loop running while focused (a little extra battery).
custom-shader = ~/.config/ghostty/shaders/coolnight-comet.glsl

# ─── Splits ────────────────────────────────────────────────────────────
split-divider-color = #214969
unfocused-split-opacity = 0.85
unfocused-split-fill = #011423
# while a split is zoomed (cmd+shift+enter), moving to another split
# zooms that one instead of dropping you out of zoom
split-preserve-zoom = navigation

# ─── Quick terminal ────────────────────────────────────────────────────
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
# drops down on whichever display the mouse is on
quick-terminal-screen = mouse

# ─── Bell ──────────────────────────────────────────────────────────────
# a bell (a build that rings when done, `tput bel`) flashes the pane's
# border and bounces the dock icon instead of beeping, so with several
# splits tiled you can see which one wants you
bell-features = no-system,no-audio,attention,title,border

# ─── Long-running commands ─────────────────────────────────────────────
# macOS notification when a command >10s finishes while you're cmd-tabbed away
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s

# ─── Shell & scrollback ────────────────────────────────────────────────
# ssh-env/ssh-terminfo: fixes TERM=xterm-ghostty breakage on remote hosts
shell-integration-features = cursor,sudo,title,path,ssh-env,ssh-terminfo
# ~100MB of scrollback per surface (allocated lazily)
scrollback-limit = 100000000

# ─── Misc ──────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

# ─── Keybindings ───────────────────────────────────────────────────────
# Built in already (no config needed):
#   cmd+shift+p  command palette        cmd+f / cmd+g    search / next match
#   cmd+d        split right            cmd+shift+d      split down
#   cmd+shift+enter  zoom split         cmd+ctrl+=       equalize splits
#   cmd+up/down  jump between prompts   cmd+z / cmd+shift+t  undo a closed tab/split
#   cmd+alt+i    terminal inspector     cmd+shift+,      reload config
#   cmd+= / cmd+- / cmd+0  font size

# Global dropdown terminal — needs Accessibility permission on first use
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Split navigation, vim-style (OmniWM owns plain alt+hjkl)
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:bottom
keybind = cmd+alt+k=goto_split:top
keybind = cmd+alt+l=goto_split:right

# Split resizing
keybind = cmd+ctrl+h=resize_split:left,40
keybind = cmd+ctrl+j=resize_split:down,40
keybind = cmd+ctrl+k=resize_split:up,40
keybind = cmd+ctrl+l=resize_split:right,40

# Pane leader (Ghostty 1.3 key tables): cmd+b, then one key
#   h j k l  move   ·  H J K L  resize  ·  \ split right  ·  - split down
#   z zoom  ·  = even out  ·  x close   ·  any other key cancels
keybind = cmd+b=activate_key_table_once:pane
keybind = pane/catch_all=deactivate_key_table
keybind = pane/escape=deactivate_key_table
keybind = pane/h=goto_split:left
keybind = pane/j=goto_split:bottom
keybind = pane/k=goto_split:top
keybind = pane/l=goto_split:right
keybind = pane/shift+h=resize_split:left,80
keybind = pane/shift+j=resize_split:down,80
keybind = pane/shift+k=resize_split:up,80
keybind = pane/shift+l=resize_split:right,80
keybind = pane/backslash=new_split:right
keybind = pane/minus=new_split:down
keybind = pane/z=toggle_split_zoom
keybind = pane/equal=equalize_splits
keybind = pane/x=close_surface

# Utility
keybind = cmd+shift+o=toggle_background_opacity
keybind = cmd+shift+s=write_scrollback_file:open
keybind = cmd+shift+r=prompt_tab_title
